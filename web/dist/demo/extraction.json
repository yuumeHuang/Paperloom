        195.47000122070312,
        562.0401000976562,
        236.80999755859375
      ],
      "text": "A PDF preserves the appearance of a page, but its visual layout does not always express the order in which a paper should be read. This self-authored example demonstrates a continuous bilingual reading experience with traceable paragraphs, figures, and tables.",
      "font_size": 10.0,
      "bold": false,
      "styles": [
        {
          "text": "A PDF preserves the appearance of a page, but its visual layout does not always express the order in which a paper should be",
          "font": "Times-Roman",
          "size": 10.0,
          "bold": false,
          "italic": false,
          "superscript": false
        },
        {
          "text": "read. This self-authored example demonstrates a continuous bilingual reading experience with traceable paragraphs, figures, and",
          "font": "Times-Roman",
          "size": 10.0,
          "bold": false,
          "italic": false,
          "superscript": false
        },
        {
          "text": "tables.",
          "font": "Times-Roman",
          "size": 10.0,
          "bold": false,
          "italic": false,
          "superscript": false
        }
      ],
      "ocr": false,
      "parent_id": null
