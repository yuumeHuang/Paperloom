        48.0,
        170.47000122070312,
        288.780029296875,
        225.80999755859375
      ],
      "text": "Translation is performed after the structure is reconstructed. Paragraph identifiers remain stable. A configurable glossary helps keep terminology consistent, and numeric checks flag values that differ between the original and translated text.",
      "font_size": 10.0,
      "bold": false,
      "styles": [
        {
          "text": "Translation is performed after the structure is reconstructed.",
          "font": "Times-Roman",
          "size": 10.0,
