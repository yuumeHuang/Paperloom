        48.0,
        87.47000122070312,
        289.3500061035156,
        156.80999755859375
      ],
      "text": "Each extracted text block is assigned a stable source identifier. The layout planner returns groups of identifiers in reading order, and the verifier checks that every source block is either used once or explicitly recorded as marginal text.",
      "font_size": 10.0,
      "bold": false,
      "styles": [
        {
          "text": "Each extracted text block is assigned a stable source",
          "font": "Times-Roman",
          "size": 10.0,
          "bold": false,
          "italic": false,
          "superscript": false
        },
        {
          "text": "identifier. The layout planner returns groups of identifiers in",
          "font": "Times-Roman",
          "size": 10.0,
          "bold": false,
          "italic": false,
          "superscript": false
        },
        {
          "text": "reading order, and the verifier checks that every source",
          "font": "Times-Roman",
          "size": 10.0,
          "bold": false,
          "italic": false,
          "superscript": false
        },
        {
          "text": "block is either used once or explicitly recorded as marginal",
          "font": "Times-Roman",
          "size": 10.0,
          "bold": false,
          "italic": false,
          "superscript": false
        },
        {
          "text": "text.",
          "font": "Times-Roman",
          "size": 10.0,
          "bold": false,
          "italic": false,
          "superscript": false
        }
      ],
      "ocr": false,
