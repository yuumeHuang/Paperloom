          "font": "Times-Roman",
          "size": 10.0,
          "bold": false,
          "italic": false,
          "superscript": false
        },
        {
          "text": "helps keep terminology consistent, and numeric checks flag",
          "font": "Times-Roman",
          "size": 10.0,
          "bold": false,
